    with open(filepath, 'rb') as f:
        content = f.read()
    
    sha256_hash = hashlib.sha256(content).hexdigest()
    
    evidence = {
        "filename": filepath,
        "sha256": sha256_hash,
        "timestamp_utc": datetime.utcnow().isoformat(),
        "owner": OWNER_REGISTRY["owner_name"],
        "contact": OWNER_REGISTRY["contact_email"],
        "copyright_claim": f"© {OWNER_REGISTRY['copyright_date']} — All proceeds to {OWNER_REGISTRY['owner_name']}",
        "qr_code_data": sha256_hash[:32],  # Truncated hash for QR scanning
    }
    return evidence

