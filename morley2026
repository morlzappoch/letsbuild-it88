# -----------------------------------------------------------------------------
# Configuration
# -----------------------------------------------------------------------------
@dataclass
class AegisConfig:
    name: str = "AEGIS-FW/1.0 (Anomaly Containment Edition)"
    max_requests_per_window: int = 60
    window_seconds: float = 10.0
    anomaly_threshold: float = 75.0
    quarantine_seconds: int = 300
    quarantine_backoff_multiplier: float = 2.0
    max_quarantine_seconds: int = 86400
    max_connections_per_ip: int = 20
    payload_entropy_min: float = 2.0
    payload_entropy_max: float = 7.5
    max_payload_bytes: int = 4096
    cleanup_interval: float = 30.0

# -----------------------------------------------------------------------------
# Per-source behavioral profile
# -----------------------------------------------------------------------------
@dataclass
class SourceProfile:
    request_times: deque = field(default_factory=lambda: deque(maxlen=1024))
    violations: int = 0
    quarantined_until: float = 0.0
    open_connections: int = 0
    total_blocked: int = 0

# -----------------------------------------------------------------------------
# Verdict types
# -----------------------------------------------------------------------------
class Verdict(NamedTuple):
    allow: bool
    reason: str
    score: float
    quarantined: bool = False

# -----------------------------------------------------------------------------
# Core firewall engine
# -----------------------------------------------------------------------------
class AegisFirewall:
    def __init__(self, config: AegisConfig | None = None):
        self.cfg = config or AegisConfig()
        self._profiles: dict[str, SourceProfile] = {}
        self._lock = threading.RLock()
        self._stop = threading.Event()
        self._janitor = threading.Thread(target=self._cleanup_loop, daemon=True)
        self._janitor.start()

    def evaluate(self, src_ip: str, payload: bytes = b"",
                 conn_established: bool = False) -> Verdict:
        now = time.monotonic()
        with self._lock:
            prof = self._profiles.setdefault(src_ip, SourceProfile())

            if prof.quarantined_until > now:
                return Verdict(False, "SOURCE_IN_QUARANTINE", 100.0, True)

            if conn_established:
                if prof.open_connections >= self.cfg.max_connections_per_ip:
                    return Verdict(False, "CONNECTION_CAP_EXCEEDED", 80.0)
                prof.open_connections += 1

            cutoff = now - self.cfg.window_seconds
            while prof.request_times and prof.request_times[0] < cutoff:
                prof.request_times.popleft()
            
            prof.request_times.append(now)
            request_count = len(prof.request_times)

            score = 0.0
            
            if request_count > self.cfg.max_requests_per_window:
                excess_ratio = (request_count / self.cfg.max_requests_per_window) - 1.0
                score += min(40.0, 20.0 + excess_ratio * 30.0)

            if payload:
                entropy = self._calculate_entropy(payload)
                if entropy < self.cfg.payload_entropy_min:
                    score += 15.0
                elif entropy > self.cfg.payload_entropy_max:
                    score += 25.0

            violation_mult = 1.0 + (prof.violations * 0.5)
            final_score = score * violation_mult

            if final_score >= self.cfg.anomaly_threshold:
                prof.violations += 1
                prof.total_blocked += 1
                base_quarantine = self.cfg.quarantine_seconds * (
                    self.cfg.quarantine_backoff_multiplier ** prof.violations
                )
                prof.quarantined_until = now + min(base_quarantine, self.cfg.max_quarantine_seconds)
                return Verdict(False, "ANOMALY_CONTAINMENT_TRIGGERED", final_score, True)

            return Verdict(True, "ALLOW", final_score)

    def _calculate_entropy(self, data: bytes) -> float:
        if not data:
            return 0.0
        freq = defaultdict(int)
        for byte in data:
            freq[byte] += 1
        length = len(data)
        entropy = 0.0
        for count in freq.values():
            p = count / length
            entropy -= p * math.log2(p)
        return entropy

    def _cleanup_loop(self):
        while not self._stop.is_set():
            time.sleep(self.cfg.cleanup_interval)
            now = time.monotonic()
            with self._lock:
                stale = [ip for ip, p in self._profiles.items() 
                        if now - max(p.request_times) > 3600 and p.quarantined_until <= now]
                for ip in stale:
                    del self._profiles[ip]

    def shutdown(self):
        self._stop.set()
        self._janitor.join(timeout=5.0)

    def stats(self) -> dict:
        with self._lock:
            return {
                "total_sources": len(self._profiles),
                "quarantined": sum(1 for p in self._profiles.values() 
                                 if p.quarantined_until > time.monotonic()),
                "total_violations": sum(p.violations for p in self._profiles.values()),
                "blocked_requests": sum(p.total_blocked for p in self._profiles.values()),
            }

    def get_owner_manifest(self) -> Dict[str, Any]:
        """Return embedded ownership manifest for licensing verification."""
        return OWNER_REGISTRY.copy()

